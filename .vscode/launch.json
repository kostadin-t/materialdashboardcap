{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run MaterialAvailability",
      "runtimeExecutable": "cds",
      "killBehavior": "polite",
      "request": "launch",
      "args": [
        "serve",
        "--with-mocks",
        "--in-memory?",
        "--profile",
        "sandbox"
      ],
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "type": "pwa-node",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "PreLaunchTask for Run MaterialAvailability",
      "envFile": "${workspaceFolder}/env/.env1",
      "env": {
        "run.config": "{\"handlerId\":\"lcap_run_config_handler_id\",\"runnableId\":\"{\\\"projectPath\\\":\\\"/home/user/projects/MaterialAvailability\\\",\\\"profileName\\\":\\\"\\\"}\"}"
      }
    },
    {
      "name": "Sales Order (A2X)",
      "runtimeExecutable": "cds",
      "request": "launch",
      "killBehavior": "polite",
      "args": [
        "serve",
        "--with-mocks",
        "--in-memory?",
        "--profile",
        "sandbox"
      ],
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "type": "pwa-node",
      "cwd": "${workspaceFolder}/",
      "preLaunchTask": "dev-project",
      "envFile": "${workspaceFolder}/env/.env2",
      "env": {
        "run.config": "{\"handlerId\":\"lcap_run_config_handler_id\",\"runnableId\":\"{\\\"projectPath\\\":\\\"/home/user/projects/MaterialAvailability/\\\",\\\"profileName\\\":\\\"\\\"}\"}"
      }
    }
  ]
}