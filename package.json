{
  "name": "MaterialAvailability",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "^3",
    "@sap-cloud-sdk/http-client": "^4.0.2",
    "@sap-cloud-sdk/resilience": "^3",
    "@sap-cloud-sdk/util": "^4.0.2",
    "@sap/cds": "^9",
    "@sap/low-code-event-handler": "^1.2.5",
    "@sap/xsenv": ">=3.3.2 <3.3.3",
    "@sap/xssec": "^4",
    "express": "^4",
    "passport": "^0.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.11.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": ">=8",
    "@sap/dev-cap-tools": "^1.31.0"
  },
  "scripts": {
    "start": "cds-serve",
    "start-local": "npm run generate-entry-point && npm run cds-watch",
    "generate-entry-point": "dev-cap-tools gen-entrypoint",
    "cds-watch": "cds watch --open",
    "watch-live": "cds watch --profile live",
    "watch-materialdashboard": "cds watch --open materialdashboard/webapp/index.html?sap-ui-xx-viewCache=false"
  },
  "cds": {
    "requires": {
      "SalesOrderA2X": {
        "kind": "odata-v2",
        "model": "srv/external/SalesOrderA2X",
        "[sandbox]": {
          "credentials": {
            "url": "https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/"
          }
        },
        "[live]": {
          "credentials": {
            "destination": "novartos4clouddev_saml",
            "path": "/sap/opu/odata/sap/API_SALES_ORDER_SRV/"
          }
        },
        "[production]": {
          "credentials": {
            "destination": "novartos4clouddev_saml",
            "path": "/sap/opu/odata/sap/API_SALES_ORDER_SRV/"
          }
        }
      },
      "ProductMasterA2X": {
        "kind": "odata-v2",
        "model": "srv/external/ProductMasterA2X",
        "[sandbox]": {
          "credentials": {
            "url": "https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/API_PRODUCT_SRV"
          }
        },
        "[live]": {
          "credentials": {
            "destination": "novartos4clouddev_saml",
            "path": "/sap/opu/odata/sap/API_PRODUCT_SRV/"
          }
        },
        "[production]": {
          "credentials": {
            "destination": "novartos4clouddev_saml",
            "path": "/sap/opu/odata/sap/API_PRODUCT_SRV/"
          }
        }
      },
      "BasicProductAvailabilityInfo": {
        "kind": "odata-v2",
        "model": "srv/external/BasicProductAvailabilityInfo",
        "[sandbox]": {
          "credentials": {
            "url": "https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/API_PRODUCT_AVAILY_INFO_BASIC"
          }
        },
        "[live]": {
          "credentials": {
            "destination": "novartos4clouddev_saml",
            "path": "/sap/opu/odata/sap/API_PRODUCT_AVAILY_INFO_BASIC/"
          }
        },
        "[production]": {
          "credentials": {
            "destination": "novartos4clouddev_saml",
            "path": "/sap/opu/odata/sap/API_PRODUCT_AVAILY_INFO_BASIC/"
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  },
  "lcap": true
}
